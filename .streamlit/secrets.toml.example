# Copy this to .streamlit/secrets.toml and fill in your credentials.
# On Streamlit Community Cloud, add these via Settings > Secrets.

[gcp]
# Paste your Google service account JSON as a single-line string:
credentials = '{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}'

# Your Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
sheet_id = "YOUR_GOOGLE_SHEET_ID_HERE"
